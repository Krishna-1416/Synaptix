{
  "rules_source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6",
  "declarations": [
    { "field": "manufacturer", "label": "Manufacturer/Packer/Importer name & address", "required": true },
    { "field": "country_of_origin", "label": "Country of Origin", "required": true },
    { "field": "generic_name", "label": "Common or generic name of the commodity", "required": true },
    { "field": "net_quantity", "label": "Net Quantity", "required": true, "format_hint": "number + unit (g/kg/ml/l/N)" },
    { "field": "manufacture_date", "label": "Month & Year of Manufacture", "required": true, "format_hint": "MM/YYYY" },
    { "field": "mrp", "label": "Maximum Retail Price (inclusive of all taxes)", "required": true, "format_hint": "₹ amount" },
    { "field": "unit_sale_price", "label": "Unit Sale Price (USP)", "required": true, "format_hint": "₹ amount / unit (e.g. ₹ 0.50/g, ₹ 120/kg)" },
    { "field": "consumer_care", "label": "Consumer Care details (name/address/phone/email)", "required": true }
  ]
}
